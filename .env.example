# =============================================================================
# Cloud-Native IoT Analytics Dashboard — Environment Template
# Copy to `.env` (root) for docker-compose, and into backend/frontend as needed.
# Everything here is FREE / self-hostable. No paid services.
# =============================================================================

# ---- General ----
APP_ENV=development                 # development | staging | production
LOG_LEVEL=debug                     # debug | info | warn | error

# ---- Backend (Gin API) ----
API_HOST=0.0.0.0
API_PORT=8080
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=15s
API_SHUTDOWN_TIMEOUT=10s
API_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- PostgreSQL ----
# Host port 5433 avoids clashing with a locally-installed Postgres on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_dev_password
POSTGRES_DB=iot_dashboard
POSTGRES_SSLMODE=disable

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MQTT (Mosquitto) ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=iot-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- Telemetry ingest pipeline ----
INGEST_WORKERS=4
INGEST_QUEUE_SIZE=1024
INGEST_HEARTBEAT_INTERVAL=30s
INGEST_OFFLINE_AFTER=90s

# ---- JWT (set strong secrets in non-dev environments) ----
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---- Frontend (Vite — must be prefixed with VITE_) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
